<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">

	<Extern href="stdidcmd.h"/>
	<Extern href="vsshlids.h"/>
	<Include href="KnownImageIds.vsct"/>
	<Include href="VSGlobals.vsct"/>

	<Commands package="Aid">
		<Groups>
			<Group guid="Aid" id="AidMenuGroup" priority="0x0600">
				<Parent guid="VSMainMenu" id="Tools"/>
			</Group>
			<Group guid="Aid" id="AidToolbarGroup" priority="0x0000">
				<Parent guid="Aid" id="AidToolbar"/>
			</Group>
		</Groups>
		<Menus>
			<Menu guid="Aid" id="AidToolbar" type="Toolbar">
				<CommandFlag>DefaultDocked</CommandFlag>
				<Strings>
					<ButtonText>Aid</ButtonText>
					<CommandName>Aid</CommandName>
				</Strings>
			</Menu>
		</Menus>

		<!--This section defines the elements the user can interact with, like a menu command or a button
        or combo box in a toolbar. -->
		<Buttons>
			<Button guid="Aid" id="CommandPaletteCommand" priority="0x0100" type="Button">
				<Parent guid="Aid" id="AidMenuGroup" />
				<Icon guid="ImageCatalogGuid" id="StatusInformation" />
				<CommandFlag>IconIsMoniker</CommandFlag>
				<Strings>
					<ButtonText>Command Palette</ButtonText>
					<LocCanonicalName>.Aid.CommandPalette</LocCanonicalName>
				</Strings>
			</Button>
			<Button guid="Aid" id="CommandPaletteToolBarCommand" priority="0x0100" type="Button">
				<Parent guid="Aid" id="AidToolbarGroup" />
				<Icon guid="ImageCatalogGuid" id="IntellisenseLightBulb" />
				<CommandFlag>IconIsMoniker</CommandFlag>
				<Strings>
					<ButtonText>Aid</ButtonText>
				</Strings>
			</Button>
		</Buttons>
	</Commands>
	<KeyBindings>
		<KeyBinding guid="Aid" id="CommandPaletteCommand" editor="guidVSStd97" mod1="Alt" key1="A"/>
	</KeyBindings>
	<Symbols>
		<GuidSymbol name="Aid" value="{c2fbb5ce-8365-4363-b7f7-94e93e1f5a93}">
			<IDSymbol name="AidMenuGroup" value="0x0001" />
			<IDSymbol name="AidToolbarGroup" value="0x0002"/>
			<IDSymbol name="AidToolbar" value="0x0003"/>
			<IDSymbol name="CommandPaletteCommand" value="0x0100" />
			<IDSymbol name="CommandPaletteToolBarCommand" value="0x0101" />
		</GuidSymbol>
	</Symbols>
</CommandTable>
