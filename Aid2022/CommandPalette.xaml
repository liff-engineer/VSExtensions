<UserControl x:Class="Aid.Shared.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Aid.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.DataContext>
        <local:CommandPaletteViewModel/>
    </UserControl.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0" Margin="0,0,0,10"
                 x:Name="Filter" TextChanged="Filter_TextChanged"
                 PreviewKeyDown="Filter_PreviewKeyDown"/>
        <ListView Grid.Row="1" x:Name="ListView"
                  SelectionMode="Single"
                  KeyDown="ListView_KeyDown"
                  MouseDoubleClick="ListView_MouseDoubleClick"
                  ItemsSource="{Binding Commands}">
            <ListView.ItemTemplate>
                <DataTemplate DataType="{x:Type local:CommandDescriptor}">
                    <TextBlock Text="{Binding Label,Mode=OneWay}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
